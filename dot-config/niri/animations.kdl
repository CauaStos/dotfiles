animations {
    slowdown 1.2

    workspace-switch {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.0001
    }

    window-open {
        duration-ms 216
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 168
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=680 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.0001
    }

    window-resize {
        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);
                return color;
            }
        "
    }

    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=620 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 216
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=620 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.001
    }
}
