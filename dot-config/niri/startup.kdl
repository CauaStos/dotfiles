spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "kdeconnectd"
spawn-at-startup "kdeconnect-indicator"
spawn-at-startup "vicinae" "server"
spawn-at-startup "awww-daemon"
spawn-at-startup "easyeffects" "--gapplication-service"
spawn-at-startup "steam" "-silent"
spawn-at-startup "zen-browser"
spawn-sh-at-startup "flatpak run sh.cider.Cider"
spawn-at-startup "vesktop" "--start-minimized"
spawn-at-startup "swayidle" "-w" "timeout" "300" "niri msg action power-off-monitors; sleep 2; hyprlock"

spawn-sh-at-startup "gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-theme 'Material'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-name 'SF Pro Text, 10'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface document-font-name 'SF Pro Text, 10'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface monospace-font-name 'SF Mono 10'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface icon-theme 'MacTahoe-dark'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-antialiasing 'grayscale'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-hinting 'none'"
