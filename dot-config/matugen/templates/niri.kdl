

// █  ▄▀█ █ █ █▄ █ █▀▀ █ █
// █▄ █▀█ █▄█ █ ▀█ █▄▄ █▀█

spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "kdeconnectd"
spawn-at-startup "kdeconnect-indicator"
spawn-at-startup "vicinae" "server"
spawn-at-startup "swww-daemon"
spawn-at-startup "easyeffects" "--gapplication-service"
spawn-at-startup "otd-daemon"
spawn-at-startup "steam" "-silent"
spawn-at-startup "zen-browser"
spawn-at-startup "spicetify" "watch" "-s"
spawn-at-startup "vesktop" "--start-minimized"
spawn-at-startup "swayidle" "-w" "timeout" "300" "niri msg action power-off-monitors; sleep 2; hyprlock"

// Theme Stuff
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-name 'Cantarell 11'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-hinting 'slight'" 
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface font-antialiasing 'grayscale'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface icon-theme 'WhiteSur'"

// █ █▄ █ █▀█ █ █ ▀█▀
// █ █ ▀█ █▀▀ █▄█  █

input {

    mod-key "Super"
    mod-key-nested "Alt"

    keyboard {
        xkb {
            layout "br"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-method "two-finger"
        scroll-factor 0.4
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
}



// █▀█ █ █ ▀█▀ █▀█ █ █ ▀█▀ █▀
// █▄█ █▄█  █  █▀▀ █▄█  █  ▄█

output "DP-1" {
  mode "2560x1440@359.999"
  scale 1.15
  variable-refresh-rate on-demand=true 
  position x=0 y=0
  focus-at-startup
}

output "DP-2" {
    mode "1920x1080@143.855"
    transform "270"
    position x=-1080 y=-380
    variable-refresh-rate on-demand=true
}




// █  ▄▀█ █ █ █▀█ █ █ ▀█▀
// █▄ █▀█  █  █▄█ █▄█  █

layout {
    gaps 8

    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
      off
    }

    border {
        width 1
        active-color "{{colors.outline.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color "{{colors.tertiary.default.hex}}"
    }


    struts {
      left 6
      right 6
    }
}



// █▀▀ █▄ █ █ █ █ █▀█ █▀█ █▄ █ █▀▄▀█ █▀▀ █▄ █ ▀█▀   █ █ ▄▀█ █▀█ █ ▄▀█ █▄▄ █  █▀▀ █▀
// ██▄ █ ▀█ ▀▄▀ █ █▀▄ █▄█ █ ▀█ █ ▀ █ ██▄ █ ▀█  █    ▀▄▀ █▀█ █▀▄ █ █▀█ █▄█ █▄ ██▄ ▄█

environment {
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt6ct"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  QT_ENABLE_HIGHDPI_SCALING "1"
  QT_AUTO_SCREEN_SCALE_FACTOR "0"
  QT_SCALE_FACTOR "1"
  QT_FONT_DPI "96"
  MOZ_ENABLE_WAYLAND "1"
  GDK_SCALE "1"
  GDK_DPI_SCALE "1"
  QSG_RENDER_LOOP "threaded"
  ELECTRON_OZONE_PLATFORM_HINT "wayland"
  GTK_THEME "Material"
}


//theme

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24

}

overview {
    zoom 0.5
    workspace-shadow { off; }
}


animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.15 stiffness=550 epsilon=0.0001
    }

    window-open {
        duration-ms 220
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 200
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.2 stiffness=500 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.25 stiffness=500 epsilon=0.0001
    }

    window-resize {
      custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);
                return color;
            }
        "
    }

    config-notification-open-close {
        spring damping-ratio=0.75 stiffness=700 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 250
        curve "ease-out-expo"
    }

    overview-open-close {
        spring damping-ratio=1.1 stiffness=550 epsilon=0.0001
    }
}


screenshot-path "~/Pictures/Screenshots/%d-%m-%Y__%H-%M-%S.png"



// █ █ █ █ █▄ █ █▀▄ █▀█ █ █ █   █▀█ █ █ █  █▀▀ █▀
// █▄▀▄█ █ █ ▀█ █▄▀ █▄█ █▄▀▄█   █▀▄ █▄█ █▄ ██▄ ▄█

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    //opacity 0.95 //not until blur
}

window-rule {
    match app-id="^[Ss]potify"
    open-on-output "DP-3"
}

window-rule {
  match is-window-cast-target=true

  border {
    on
    width 1
    active-color "{{colors.error.light.hex}}"
    inactive-color "{{colors.error.light.hex}}"
  }
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false

}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}


window-rule {
    match title="^About Mozilla Firefox$"
    match app-id="^firefox$"
    match app-id="^foot$"
    match app-id="^vlc$"
    match app-id="^kvantummanager$"
    match app-id="^qt5ct$"
    match app-id="^qt6ct$"
    match app-id="^nwg-look$"
    match app-id="^org.kde.ark$"
    match app-id="^pavucontrol-qt$"
    match app-id="^blueman-manager$"
    match app-id="^nm-applet$"
    match app-id="^nm-connection-editor$"
    match app-id="^org.kde.polkit-kde-authentication-agent-1$"
    match title="^Mission Center$"
    match app-id="^Signal$"
    match app-id="^com.github.rafostar.Clapper$"
    match app-id="^app.drey.Warp$"
    match app-id="^net.davidotek.pupgui2$"
    match app-id="^yad$"
    match app-id="^eog$"
    match app-id="^io.github.alainm23.planify$"
    match app-id="^io.gitlab.theevilssskeleton.Upscaler$"
    match app-id="^com.github.unrud.VideoDownloader$"
    match app-id="^io.gitlab.adhami3310.Impression$"
    match app-id="^mate-system-monitor$"
    match app-id="^zenity$"

    open-floating true

}


// █  ▄▀█ █ █ █▀▀ █▀█   █▀█ █ █ █  █▀▀ █▀
// █▄ █▀█  █  ██▄ █▀▄   █▀▄ █▄█ █▄ ██▄ ▄█

layer-rule {
    match namespace="Sidus"
    place-within-backdrop true
}

layer-rule {
    match namespace="swww-daemon"
    place-within-backdrop true
}


// █▄▀ █▀▀ █ █ █▄▄ █ █▄ █ █▀▄ █▀
// █ █ ██▄  █  █▄█ █ █ ▀█ █▄▀ ▄█

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ▄▀█ █▀█ █▀█ █▀
    // █▀█ █▀▀ █▀▀ ▄█


    Mod+T hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="File Manager" {spawn "nautilus"; }
    Mod+C hotkey-overlay-title="Code Editor" {spawn "zeditor"; }
    Mod+F hotkey-overlay-title="Browser" {spawn "zen-browser"; }
    Mod+A hotkey-overlay-title="Application Launcher" { spawn "vicinae" "toggle"; }
    Ctrl+Shift+Escape hotkey-overlay-title="System Monitor" { spawn "missioncenter"; }




    // ▄▀█ █▀▀ ▀█▀ █ █▀█ █▄ █ █▀
    // █▀█ █▄▄  █  █ █▄█ █ ▀█ ▄█

    Mod+Q { close-window; }
    Mod+Delete { quit skip-confirmation=true; }
    Mod+W       { toggle-window-floating; }
    Alt+Return { fullscreen-window; }
    Mod+L hotkey-overlay-title="Screenlock" { spawn "hyprlock"; }



    // █ █ █ █ █▄ █ █▀▄ █▀█ █ █ █ █▀
    // █▄▀▄█ █ █ ▀█ █▄▀ █▄█ █▄▀▄█ ▄█

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Ctrl+Left { set-column-width "50%"; }
    Mod+Ctrl+Right { set-column-width "100%"; }


    // █ █ █ █▀█ █▀█ █▄▀ █▀ █▀█ ▄▀█ █▀▀ █▀▀ █▀
    // █▄▀▄█ █▄█ █▀▄ █ █ ▄█ █▀▀ █▀█ █▄▄ ██▄ ▄█

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+Ctrl+Shift+Left { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-window-to-monitor-right; }


    // █ █ ▀█▀ █ █  █ ▀█▀ █ █
    // █▄█  █  █ █▄ █  █   █

    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }



    // █▀▄▀█ █ █▀ █▀▀ █▀▀ █  ▄▀█ █▄ █ █▀▀ █▀█ █ █ █▀
    // █ ▀ █ █ ▄█ █▄▄ ██▄ █▄ █▀█ █ ▀█ ██▄ █▄█ █▄█ ▄█

    Ctrl+Alt+Z { spawn "wtype" "-k" "backslash"; }
    Shift+Alt+Z { spawn "wtype" "|"; }
    Home { spawn "wtype" "/"; }
    Shift+Home { spawn "wtype" "?"; }

    Mod+Shift+P { power-off-monitors; }
  }

debug {
    keep-max-bpc-unchanged
}



