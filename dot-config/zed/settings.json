{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "disable_ai": true,
  "git": {
    "inline_blame": {
      "enabled": true
    },
    "git_gutter": "tracked_files"
  },
  "agent": {
    "button": true,
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "git_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "centered_layout": {
    "left_padding": 0.2
  },
  "bottom_dock_layout": "contained",
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_branch_name": true,
    "show_branch_icon": false
  },
  "debugger": {
    "button": true
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "cursor_shape": "bar",
    "dock": "right",
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "hide_root": false,
    "auto_fold_dirs": true,
    "starts_open": true,
    "auto_reveal_entries": true,
    "indent_size": 20.0,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "dock": "left",
    "button": true
  },
  "close_on_file_delete": true,
  "use_smartcase_search": true,
  "lsp_document_colors": "inlay",
  "inlay_hints": {
    "show_background": true,
    "enabled": true
  },
  "soft_wrap": "editor_width",
  "tab_size": 4,
  "toolbar": {
    "agent_review": true,
    "code_actions": true
  },
  "minimap": {
    "thumb": "hover",
    "show": "always"
  },
  "scrollbar": {
    "axes": {
      "horizontal": true
    },
    "show": "never"
  },
  "relative_line_numbers": "enabled",
  "autosave": {
    "after_delay": {
      "milliseconds": 100
    }
  },
  "vim_mode": true,
  "cursor_shape": "bar",
  "auto_update": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "use_system_path_prompts": true,
  "when_closing_with_no_tabs": "platform_default",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Material - Matugen"
  },
  "theme_overrides": {
    "Material - Matugen": {
      "background.appearance": "blurred"
    }
  }
}
