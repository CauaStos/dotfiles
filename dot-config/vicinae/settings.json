            },
            "bvnc": {
               "enabled": false
            },
            "designer": {
               "enabled": false
            },
            "jconsole-java-openjdk": {
               "enabled": false
            },
            "jshell-java-openjdk": {
               "enabled": false
            },
            "kdesystemsettings": {
               "enabled": false
            },
            "linguist": {
               "enabled": false
            },
            "lstopo": {
               "enabled": false
            },
            "nvim": {
               "enabled": false
            },
            "nvtop": {
               "enabled": false
            },
            "org.freedesktop.IBus.Setup": {
               "enabled": false
            },
            "org.gnome.Logs": {
               "enabled": false
            },
            "org.gnome.font-viewer": {
               "enabled": false
            },
            "org.kde.kdeconnect.nonplasma": {
               "enabled": false
            },
            "org.kde.kdeconnect.sms": {
               "enabled": false
            },
            "org.rncbc.qtractor": {
               "enabled": false
            },
            "protontricks": {
               "enabled": false
