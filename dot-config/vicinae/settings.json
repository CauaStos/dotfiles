            },
            "winetricks": {
               "enabled": false
            }
         }
      },
      "clipboard": {
         "preferences": {
            "eraseOnStartup": true
         }
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
